# 機密情報・環境変数
.venv/
__pycache__/
*.pyc
*.pem

# 環境変数ファイル（全階層の .env 関連ファイルを一括除外）
**/.env
**/.env.*

# ただし、テンプレートファイル（.env.example）だけは例外としてGitで管理する
!**/.env.example

# ローカルデータ・ログ
*.log
docker-data/
db_data/

# OS生成ファイル・ログ
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --------------------------------------------------
# Frontend (Next.js / Node)
# --------------------------------------------------
node_modules/
frontend/node_modules/
frontend/.pnp/
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
frontend/coverage/

# next.js
frontend/.next/
frontend/out/

# production
frontend/build/

# vercel
frontend/.vercel/

# typescript
frontend/*.tsbuildinfo
